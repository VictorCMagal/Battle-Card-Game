# Copie para .env e ajuste. NUNCA versione o arquivo .env.
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SECURE_COOKIES=False

# Banco MySQL
DB_ENGINE=mysql
DB_NAME=battle_card_game
DB_USER=bcg_user
DB_PASSWORD=troque-esta-senha
DB_HOST=127.0.0.1
DB_PORT=3306

# Canal de mensagens: memory (um processo, sem Redis) ou redis
CHANNEL_LAYER=memory
REDIS_URL=redis://127.0.0.1:6379/0

# Idioma e fuso (relógio do chat)
IDIOMA=PT-BR
TIME_ZONE=America/Sao_Paulo

# Logs
LOG_DIR=logs
LOG_LEVEL=INFO

# Dados de teste (comando seed_dev). Valores de DEMONSTRAÇÃO: troque se expor o servidor.
SEED_TEST_PASSWORD=teste1234
